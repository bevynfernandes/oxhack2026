{
  "$defs": {
    "RowIdentity": {
      "additionalProperties": false,
      "description": "Frozen tool/package/company identity within one ecosystem and dataset.",
      "properties": {
        "tool_id": {
          "minLength": 1,
          "title": "Tool Id",
          "type": "string"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "package_id": {
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "ecosystem": {
          "enum": [
            "npm",
            "pypi"
          ],
          "title": "Ecosystem",
          "type": "string"
        },
        "dataset_version": {
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "mapping_version": {
          "minLength": 1,
          "title": "Mapping Version",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "organization_id",
        "package_id",
        "ecosystem",
        "dataset_version",
        "mapping_version"
      ],
      "title": "RowIdentity",
      "type": "object"
    },
    "TargetWindows": {
      "additionalProperties": false,
      "description": "One decision's target definition, fixed observation anchor, and windows.",
      "properties": {
        "target_id": {
          "enum": [
            "downloads_next_30d_v1",
            "downloads_trailing_28d_at_91d_v1"
          ],
          "title": "Target Id",
          "type": "string"
        },
        "decision_at": {
          "format": "date-time",
          "title": "Decision At",
          "type": "string"
        },
        "observation_window_end": {
          "format": "date-time",
          "title": "Observation Window End",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/TimeWindow"
        },
        "target": {
          "$ref": "#/$defs/TimeWindow"
        },
        "definition_version": {
          "const": "targets-v1",
          "default": "targets-v1",
          "title": "Definition Version",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "decision_at",
        "observation_window_end",
        "reference",
        "target"
      ],
      "title": "TargetWindows",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Nonempty half-open measurement interval with timezone-aware UTC bounds.",
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Feature vector with explicit missingness and immutable source references.",
  "properties": {
    "feature_row_id": {
      "title": "Feature Row Id",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/RowIdentity"
    },
    "windows": {
      "$ref": "#/$defs/TargetWindows"
    },
    "mode": {
      "enum": [
        "reconstructed",
        "prospective"
      ],
      "title": "Mode",
      "type": "string"
    },
    "feature_schema_version": {
      "title": "Feature Schema Version",
      "type": "string"
    },
    "values": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Values",
      "type": "object"
    },
    "complete_history_days": {
      "minimum": 0,
      "title": "Complete History Days",
      "type": "integer"
    },
    "source_revision_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Revision Ids",
      "type": "array"
    },
    "forecast_eligible": {
      "title": "Forecast Eligible",
      "type": "boolean"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "enum": [
          "insufficient_history",
          "missing_source",
          "low_reference_count",
          "unverified_mapping",
          "unvalidated_interval",
          "immature_outcome"
        ],
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "feature_row_id",
    "identity",
    "windows",
    "mode",
    "feature_schema_version",
    "values",
    "complete_history_days",
    "source_revision_ids",
    "forecast_eligible"
  ],
  "title": "FeatureRow",
  "type": "object"
}
