{
  "$defs": {
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Nonempty half-open measurement interval with timezone-aware UTC bounds.",
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Dated measured evidence, separate from cautious predictive interpretations.",
  "properties": {
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "tool_id": {
      "title": "Tool Id",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "source_revision_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Revision Ids",
      "type": "array"
    },
    "window": {
      "$ref": "#/$defs/TimeWindow"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "availability_basis": {
      "title": "Availability Basis",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "measured_change": {
      "title": "Measured Change",
      "type": "string"
    },
    "predictive_interpretation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predictive Interpretation"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "evidence_id",
    "tool_id",
    "source",
    "source_revision_ids",
    "window",
    "available_at",
    "availability_basis",
    "measured_change"
  ],
  "title": "EvidenceItem",
  "type": "object"
}
