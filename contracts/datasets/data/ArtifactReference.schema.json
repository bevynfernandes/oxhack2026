{
  "additionalProperties": false,
  "description": "Hashed artifact relative to a configured bundle root, never a signed URL.",
  "properties": {
    "path": {
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "byte_size": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "media_type": {
      "enum": [
        "application/json",
        "application/x-ndjson",
        "application/vnd.apache.parquet",
        "application/octet-stream"
      ],
      "title": "Media Type",
      "type": "string"
    }
  },
  "required": [
    "path",
    "sha256",
    "byte_size",
    "media_type"
  ],
  "title": "ArtifactReference",
  "type": "object"
}
