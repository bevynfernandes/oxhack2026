{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "Hashed artifact relative to a configured bundle root, never a signed URL.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "application/json",
            "application/x-ndjson",
            "application/vnd.apache.parquet",
            "application/octet-stream"
          ],
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hash-pinned assessment array and the exact source manifest it consumed.",
  "properties": {
    "schema_version": {
      "const": "company-assessment-publication-v1",
      "default": "company-assessment-publication-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Publication Id",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "policy_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Policy Version",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "company_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
        "type": "string"
      },
      "title": "Company Ids",
      "type": "array"
    },
    "source_manifest": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "assessments": {
      "$ref": "#/$defs/ArtifactReference"
    }
  },
  "required": [
    "publication_id",
    "source_snapshot_id",
    "as_of",
    "recorded_at",
    "policy_version",
    "synthetic",
    "company_ids",
    "source_manifest",
    "assessments"
  ],
  "title": "CompanyAssessmentManifest",
  "type": "object"
}
