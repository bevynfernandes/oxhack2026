# Optional integrations remain inactive until explicitly configured.
SIGNALSHIFT_ENV=local
DATA_ROOT=./data
MODEL_ROOT=./artifacts
DATABASE_URL=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GITHUB_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
VULTR_API_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Explicit company API runtime; values are examples, never automatic defaults.
# SIGNALSHIFT_COMPANY_ROOT=/absolute/path/to/restored-company-store
# SIGNALSHIFT_COMPANY_PUBLICATIONS=company-assessments-vector-20261024-v1
# Enable bounded public research writes with one ASGI worker process:
# SIGNALSHIFT_RESEARCH_ENABLED=1

# Standalone v2 research; defaults to SIGNALSHIFT_COMPANY_ROOT when set.
# SIGNALSHIFT_RESEARCH_ROOT=/absolute/path/to/writable-research-store
# SIGNALSHIFT_RESEARCH_BROWSER=1
# SIGNALSHIFT_RESEARCH_REGISTRY_MAPPINGS=/absolute/path/to/reviewed-mappings.json
SEC_USER_AGENT=
COMPANIES_HOUSE_API_KEY=

# Optional override for the packaged experimental dimension model bundle:
# SIGNALSHIFT_DIMENSION_MODELS_ROOT=/absolute/path/to/verified/model-bundle
