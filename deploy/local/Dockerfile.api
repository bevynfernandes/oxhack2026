FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /bin/uv
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" UV_LINK_MODE=copy PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra data --extra api --extra research --no-install-project
COPY README.md ./
COPY oxhack2026 ./oxhack2026
RUN uv sync --frozen --no-dev --extra data --extra api --extra research --no-editable \
    && .venv/bin/playwright install --with-deps chromium \
    && useradd --create-home --uid 10001 signalshift
USER signalshift
EXPOSE 8000
CMD ["uvicorn", "oxhack2026.api.company_runtime:create_company_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
